# AURELIUM configuration. Copy this file to .env and fill in the values.
# Phase 1 (the face) needs nothing here. Phase 2 (voice + brain) uses the keys below.

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: OpenAI key for Whisper transcription via API (only if local Whisper is too slow on your machine)
OPENAI_API_KEY=
