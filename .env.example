# AURELIUM configuration. Copy this file to .env (npm run setup does it) and fill in the values.

# ---- Brain: Anthropic / Claude ----
# Get a key: https://console.anthropic.com/settings/keys  ->  "Create Key"
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies (recommended for voice). medium/high = more thinking.
CLAUDE_EFFORT=low

# ---- Voice: ElevenLabs ----
# Get a key: https://elevenlabs.io/app/settings/api-keys  ->  "Create API Key"
# Give it these permissions: Text to Speech, Speech to Text, Voices (read + write).
ELEVENLABS_API_KEY=
# Juan's chosen voice: Option A "Cate - Resonant, Deep and Elegant" (already added to the account).
ELEVENLABS_VOICE_ID=J64VNrjLE6uKFBKlxfSJ
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Ears: speech-to-text ----
# auto = local Whisper on Apple Silicon / strong PCs, otherwise ElevenLabs Scribe. Options: auto | local | elevenlabs | openai
STT_MODE=auto
WHISPER_MODEL=Xenova/whisper-base.en
# Optional: only needed if STT_MODE=openai
OPENAI_API_KEY=

# ---- Controls ----
# Global push-to-talk toggle (works from any app). Hold Space inside the app also works.
PTT_HOTKEY=Alt+Space
# Always-on wake word. on/off. Uses the microphone continuously and transcribes short bursts of speech.
WAKE_WORD=off
WAKE_WORD_TEXT=motion
USER_NAME=Juan
# What she calls herself.
ASSISTANT_NAME=Motion

# ---- Web ----
# Lets her search the web and read pages (runs on Anthropic's side, no extra key). on/off
WEB_SEARCH=on
